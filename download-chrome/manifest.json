{
  "manifest_version": 3,
  "name": "Clip Saver",
  "short_name": "Clip Saver",
  "version": "1.2.0",
  "description": "Find accessible video, audio and podcast files on sites across the web. English/Russian UI; advisory license information.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip Saver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
