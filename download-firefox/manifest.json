{
  "manifest_version": 3,
  "name": "OK Clip Saver",
  "short_name": "OK Saver",
  "version": "1.0.0",
  "description": "Save accessible OK.ru videos with an English/Russian interface and informational license indicator.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OK Clip Saver",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "media.js",
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ok-clip-saver@local.dev",
      "strict_min_version": "121.0"
    }
  }
}
